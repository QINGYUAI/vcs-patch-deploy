# PHP 后端增量部署（vcs-patch-deploy）

# ---------- 后端与 VCS ----------
# 后端类型（v1 仅 php）
PATCH_BACKEND=php
# svn | git；留空则自动检测
# PATCH_VCS=svn

# PHP 项目根（ThinkPHP 含 app/ config/ 的目录）
# PATCH_SOURCE_DIR=/path/to/your-php-api

# deploy 配置目录（含 .last-deploy-marker、out/）
# PATCH_DEPLOY_DIR=/path/to/your-php-api/deploy

# 服务器 apply-update.php：备份根目录（默认 <Backend>/.deploy-backups/）
# PATCH_BACKUP_DIR=/data/backups/my-api

# 服务器 apply-update.php：备份会话保留数量（默认 10，部署成功后自动清理）
# PATCH_KEEP_BACKUPS=10

# zip 文件名前缀
# PATCH_ZIP_PREFIX=backend-update

# zip 压缩级别 0-9（默认 6，原 9 较慢）
# PATCH_ZIP_LEVEL=6

# 安装版本号（patch-build --version= 的默认值）
# PATCH_VERSION=1.2.3

# 仅打包/部署的文件列表（每行一个相对路径）
# PATCH_FILE_LIST=hotfix-files.txt

# 允许用工作区内容打包（跳过与目标版本的一致性校验，默认 false）
# PATCH_FROM_WORKTREE=false

# SVN：直接打包工作副本改动（对比基准 revision，含未提交文件，默认 false）
# PATCH_DIFF_WORKTREE=false

# 自定义 apply-update.php 模板（默认使用插件内置模板）
# PATCH_APPLY_SCRIPT=deploy/apply-update.php

# 多环境基准名称（使用 deploy/.last-deploy-marker.<profile>）
# PATCH_PROFILE=php85

# 受保护文件（线上已存在则跳过覆盖，逗号分隔；也可用 deploy/protect.txt）
# PATCH_PROTECT=config/date_config.json
# PATCH_PROTECT_FILE=protect-files.txt

# 服务器 apply-update.php：仅部署指定文件（逗号分隔）
# PATCH_DEPLOY_FILES=app/service/Foo.php,app/controller/Bar.php

# 跳过 PHP 项目结构校验（非标准目录时使用）
# PATCH_SKIP_VALIDATION=false

# 本地版本归档（deploy/archive/，默认保留 10 个版本）
# PATCH_NO_ARCHIVE=false
# PATCH_KEEP_VERSIONS=10
# 归档时优先硬链接（同一磁盘可节省约一半空间）
# PATCH_ARCHIVE_LINK=false

# 构建后清理 deploy/out 旧产物（patch-* 目录 / zip，默认 false）
# PATCH_PRUNE_OUT=false
# deploy/out 保留数量（默认同 PATCH_KEEP_VERSIONS）
# PATCH_KEEP_OUT=10

# ---------- 工具路径（可选）----------
# SVN_EXE=C:/Program Files/TortoiseSVN/bin/svn.exe
# GIT_EXE=C:/Program Files/Git/bin/git.exe
