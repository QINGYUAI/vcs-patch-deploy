# PHP 后端增量部署（vcs-patch-deploy）

# ---------- 后端与 VCS ----------
# 后端类型（v1 仅 php）
PATCH_BACKEND=php
# svn | git；留空则自动检测
# PATCH_VCS=svn

# PHP 项目根（ThinkPHP 含 app/ config/ 的目录）
# PATCH_SOURCE_DIR=/path/to/your-php-api

# deploy 配置目录（含 .last-deploy-marker、out/）
# PATCH_DEPLOY_DIR=/path/to/your-php-api/deploy

# 服务器 apply-update.php：备份根目录（默认 <Backend>/.deploy-backups/）
# PATCH_BACKUP_DIR=/data/backups/my-api

# zip 文件名前缀
# PATCH_ZIP_PREFIX=backend-update

# zip 压缩级别 0-9（默认 6，原 9 较慢）
# PATCH_ZIP_LEVEL=6

# 安装版本号（patch-build --version= 的默认值）
# PATCH_VERSION=1.2.3

# 仅打包/部署的文件列表（每行一个相对路径）
# PATCH_FILE_LIST=hotfix-files.txt

# 服务器 apply-update.php：仅部署指定文件（逗号分隔）
# PATCH_DEPLOY_FILES=app/service/Foo.php,app/controller/Bar.php

# 跳过 PHP 项目结构校验（非标准目录时使用）
# PATCH_SKIP_VALIDATION=false

# 本地版本归档（deploy/archive/，默认保留 10 个版本）
# PATCH_NO_ARCHIVE=false
# PATCH_KEEP_VERSIONS=10

# ---------- 工具路径（可选）----------
# SVN_EXE=C:/Program Files/TortoiseSVN/bin/svn.exe
# GIT_EXE=C:/Program Files/Git/bin/git.exe
